# ═══════════════════════════════════════════════════
# SYNAPSE 2027 — Environment Variables Reference
# Initiated by VERVE Club, IILM University | Site by Mayank
# ═══════════════════════════════════════════════════

# Server Port (Default: 3000, auto-assigned on Vercel/Railway)
PORT=3000

# Environment Mode ('development' or 'production')
NODE_ENV=development

# Allowed CORS Origins (comma-separated, optional)
# ALLOWED_ORIGINS=https://synapse2027.iilm.edu,https://synapse-27.vercel.app

# Admin Access Passcode (optional)
# ADMIN_KEY=synapse2027-secret-pass

# ═══════════════════════════════════════════════════
# SMTP Email Settings (Optional)
# If omitted, system defaults to automated test inbox (Ethereal)
# ═══════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=verve.synapse2027@gmail.com
# SMTP_PASS=your-gmail-app-password
# FROM_EMAIL="SYNAPSE 2027 (VERVE Club IILM)" <synapse2027@iilm.edu>
